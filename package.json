{
  "name": "enletrados",
  "version": "0.1.0",
  "private": true,
  "description": "Juegos de palabras en español neutro para Latinoamérica",
  "scripts": {
    "datos": "sh herramientas/descargar_datos.sh",
    "generar": "node herramientas/generar.js",
    "generar:vigentes": "node herramientas/generar.js --vigentes",
    "revisar": "node herramientas/revisar_pistas.js",
    "probar": "node herramientas/probar_niveles.js",
    "construir": "node herramientas/construir.js",
    "start": "node herramientas/servidor.js",
    "dev": "node herramientas/servidor.js --vigilar",
    "capturas": "node herramientas/pruebas/capturas.js",
    "kenney": "sh herramientas/descargar_kenney.sh",
    "pueblo": "node herramientas/pueblo/armar.js && node herramientas/pueblo/escenas.js",
    "escenas": "node herramientas/pruebas/escenas.js",
    "compartir": "node herramientas/pruebas/imagen_compartir.js",
    "prueba:anuncios": "node herramientas/pruebas/anuncios.js",
    "anuncio": "node herramientas/videos/anuncio.js",
    "videos": "node herramientas/videos/guiones.js todos",
    "publicar": "sh herramientas/publicar.sh",
    "paquete": "sh herramientas/paquete.sh",
    "construir:publicado": "node herramientas/construir.js --publicado",
    "seguridad": "node herramientas/pruebas/seguridad.js"
  }
}
