# Copia este archivo como .env y completa los valores. El .env nunca se sube a GitHub ni al sitio.
# Token de cuenta de Cloudflare con permiso para editar el Worker «enletrados» (Workers Scripts · Editar).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Nombre del Worker en Cloudflare (como aparece en Workers y Pages)
CF_PROYECTO=
