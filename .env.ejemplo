# Copia este archivo como .env y completa los valores. El .env nunca se sube a GitHub ni al sitio.
# Token de Cloudflare con un solo permiso: Cuenta · Cloudflare Pages · Editar (ver la guía en CLAUDE.md).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Nombre del proyecto en Cloudflare Pages (como aparece en Workers y Pages)
CF_PROYECTO=
